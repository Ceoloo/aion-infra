[Unit]
Description=AION deployment config + Postgres roles encrypted off-host backup (aion-infra#13)
OnFailure=aion-backup-alert@%n.service
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/aion-backup/bin/backup-aion-config.sh run
TimeoutStartSec=600
