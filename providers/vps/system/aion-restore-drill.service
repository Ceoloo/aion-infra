[Unit]
Description=AION weekly restore validation (runtime hourly+config rehearsal, runtime daily, isolated Supabase)
OnFailure=aion-backup-alert@%n.service
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/aion-backup/bin/run-restore-drills.sh
TimeoutStartSec=3600
Nice=10
