# aion-monitor config — root-owned 0600 at /opt/aion/.env.monitor
# Separate from /opt/aion/.env: this file has NO access to deploy/runtime
# secrets, only monitor thresholds + (optionally) an alert destination.
# Copy to /opt/aion/.env.monitor and edit. Safe to leave ALERT_WEBHOOK_URL
# unset — the monitor still detects and logs, it just won't deliver
# externally until a destination is authorized (see aion-infra#14).

CONTAINER_NAME=aion-aion-runtime-1
HEALTH_URL=https://runtime.srv1655818.hstgr.cloud/health/ready

# Consecutive bad/good polls before alerting/recovering. At the default 60s
# timer interval: BAD_THRESHOLD=3 -> alert after ~2-3 min of sustained
# failure, not on one blip. GOOD_THRESHOLD=2 -> recovery notice after ~1-2
# consecutive good polls.
BAD_THRESHOLD=3
GOOD_THRESHOLD=2

# RestartCount jump within one poll interval, same container instance,
# treated as a crash-loop even if caught momentarily "running" between
# restarts (fast crash loops can look transiently healthy to a single poll).
RESTART_JUMP_THRESHOLD=2

# Re-notify cadence while an incident stays open (seconds). 1800 = 30 min.
RE_ALERT_SECONDS=1800

# Authorized 2026-09-20: reuses the existing ntfy.sh channel already used
# by the backup system (topic in /root/.backup-secrets/ntfy.env) rather
# than standing up a new destination. To point elsewhere instead, set
# ALERT_WEBHOOK_URL to a Slack/Discord/generic incoming webhook and
# ALERT_FORMAT=slack (default) or raw. Leave both unset for log-only.
ALERT_WEBHOOK_URL=https://ntfy.sh/<topic-from-ntfy.env>
ALERT_FORMAT=ntfy   # ntfy | slack | raw
