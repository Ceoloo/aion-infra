# aion-backup config — root-owned 0600 at /opt/aion/.env.backup
# Copy to /opt/aion/.env.backup and fill in. NOT active until this file
# exists AND aion-backup.timer is enabled (see docs/runbook.md — "Enable
# off-host backups"). Neither is done by default; backup.sh fails loudly
# rather than silently skipping if this file is missing required values.

# A READ-capable Postgres URL (aion_app is sufficient — pg_dump needs no
# elevated role). Never the migrator credential.
PGDUMP_URL=postgresql://aion_app:<password>@127.0.0.1:5432/aion_data

# Symmetric passphrase for the dump encryption (openssl aes-256-cbc). Store
# this SEPARATELY from the VPS itself (password manager, not another file
# on this box) — losing it makes every backup unrecoverable.
BACKUP_PASSPHRASE=<generate with: openssl rand -base64 32>

# Cloudflare R2 (S3-compatible) — recommended: free egress, ~$0.015/GB-month,
# fits this workload's ~66MB DB trivially. Create at dash.cloudflare.com ->
# R2 -> create bucket "aion-backups" -> Manage API Tokens -> create a token
# scoped to ONLY that bucket (Object Read & Write). R2 gives you the
# S3-compatible endpoint on the bucket's page:
#   https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=aion-backups
AWS_ACCESS_KEY_ID=<r2 access key id>
AWS_SECRET_ACCESS_KEY=<r2 secret access key>

RETENTION_DAYS=14
