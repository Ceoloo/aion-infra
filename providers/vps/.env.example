# ============================================================================
# AION VPS profile — environment file (PLACEHOLDERS ONLY — never commit real
# values). Copy to `/opt/aion/.env` on the SERVER, owned by root, mode 0600:
#     install -o root -g root -m 0600 .env.example /opt/aion/.env   # then edit
# This file is the VPS implementation of the AION secrets contract (§12).
# ============================================================================

# ── Runtime contract vars (provider-neutral — identical across VPS/AWS/GCP) ──
AION_ENVIRONMENT=production
LOG_LEVEL=info
SERVICE_VERSION=0.1.0
GIT_SHA=REPLACE_WITH_DEPLOYED_SHA
DATABASE_SSL=false            # false for Mode A local DB; true for remote managed DB

# Application-role connection (DML only). The runtime NEVER gets the migrator URL.
#   Mode A (local DB):   host = postgres (the compose service)
#   Mode B (managed DB): host = your managed PostgreSQL endpoint, DATABASE_SSL=true
DATABASE_URL=postgresql://aion_app:CHANGE_ME@postgres:5432/aion_data

# Migration-role connection (DDL). Used ONLY by the one-shot migration run
# (providers/vps/scripts/deploy.sh), never by the long-running runtime.
MIGRATION_DATABASE_URL=postgresql://aion_migrator:CHANGE_ME@postgres:5432/aion_data

# ── Edge (Traefik — OPS-001) ─────────────────────────────────────────────────
# Prefer a stable, provider-independent hostname (not the Hostinger machine FQDN).
AION_DOMAIN=runtime.aionsystems.ai
# Name of the Docker network Traefik uses to reach the Runtime container.
AION_TRAEFIK_NETWORK=aion_edge
# How that network is owned — pick the row that matches the host Traefik:
#   true  → Traefik runs on its OWN Docker network (DO/Hetzner-style setups).
#           Set AION_TRAEFIK_NETWORK to that existing network; deploy only
#           ATTACHES to it and fails if it is absent.
#   false → Traefik runs with `network_mode: host` (the Hostinger box). It joins
#           no Docker network; AION owns the edge bridge. deploy.sh creates
#           AION_TRAEFIK_NETWORK if missing; a host-network Traefik still routes
#           to the container's IP on that bridge.
AION_TRAEFIK_NETWORK_EXTERNAL=false
# Traefik entrypoint + cert resolver names MUST match the host Traefik config.
AION_TRAEFIK_ENTRYPOINT=websecure
AION_TRAEFIK_CERT_RESOLVER=letsencrypt

# ── Browser Console CORS (Vercel Operator Console) ───────────────────────────
# Comma-separated exact origins. Empty = no CORS headers (same-origin / edge only).
# Enforced at the TRAEFIK EDGE (docker-compose.yml `aion-cors` middleware) — the
# Runtime image is origin-agnostic. Traefik answers preflight and adds
# Access-Control-Allow-Origin for a matching Origin only. No credentials.
# Frontend VITE_AION_TENANT_ID / VITE_AION_OPERATOR_ID are HINTS only — not authority.
AION_CORS_ORIGINS=https://aion-operator-console.vercel.app

# ── Deploy target image (the SAME image built for every provider) ────────────
# DIGEST-PINNED — the deployment identity is an immutable manifest digest, never
# a tag. deploy-vps.yml resolves a release tag to @sha256:<digest> and writes it
# here. GIT_SHA above stays the real aion-runtime commit (40-hex), not a tag.
AION_IMAGE=ghcr.io/ceoloo/aion-runtime@sha256:REPLACE_WITH_MANIFEST_DIGEST

# ── Mode A local Postgres only (omit entirely for Mode B managed DB) ─────────
# Set AION_LOCAL_DB=1 so scripts/deploy.sh brings up the postgres service and
# waits for it (CI passes no flags — it reads this from .env). Omit for Mode B.
AION_LOCAL_DB=1
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=aion_data
AION_APP_PASSWORD=CHANGE_ME_APP
AION_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR

# ── Optional Revenue Copilot image (compose profile: revenue-copilot) ─────────
# COPILOT_IMAGE=ghcr.io/ceoloo/aion-revenue-copilot:a9d2edeb5a33b38fb6f2459ed2b11762490db458
# COPILOT_DOMAIN=copilot.aionsystems.ai
# Durable Runtime for Copilot /v1 commands (required for production /api path):
# AION_RUNTIME_URL=https://runtime.srv1655818.hstgr.cloud
# AION_TENANT_ID=aion-systems

# ── Integration credentials (external execution environments) ────────────────
# Secrets for external services AION acts THROUGH (an LLM router; a CRM). They
# live in this root-owned 0600 file like every other secret, and are rotated by
# editing this file and re-rolling the consuming service.
#
# Split allowlist (least privilege):
#   * OpenRouter / model keys → Revenue Copilot (and similar product services)
#     only — do NOT add them to `aion-runtime`.
#   * GHL_* → `aion-runtime` for Phase A/B live CRM via the GHL adapter +
#     Execution Gateway (see docker-compose.yml `aion-runtime` environment).
# See docs/design/external-credentials.md.
#
# Only *_API_KEY values are secrets; the model id / location id / version are
# ordinary config.

# OpenRouter (model router) — https://openrouter.ai/keys
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_KEY      # sk-or-... (spend-limited)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet     # config, not a secret

# GoHighLevel (CRM) — Private Integration Token, least-privilege scopes only
# Required for live Phase A/B. PIT must authorize at least:
#   locations.readonly (prove location bind)
#   contacts.readonly + contacts.write (notes/tasks/upsert)
#   opportunities.readonly + opportunities.write (pipelines + stage update)
#   conversations.readonly, calendars.readonly (Phase A reads)
# A locations-only token authenticates but fails CRM reads with scope 401.
GHL_API_KEY=CHANGE_ME_GHL_PRIVATE_TOKEN          # pit-...
GHL_LOCATION_ID=CHANGE_ME_GHL_LOCATION_ID        # config, not a secret
GHL_API_VERSION=2021-07-28                        # config, not a secret
