# AION Infra — LOCAL developer configuration (PLACEHOLDERS ONLY).
#
# aion-docs/architecture/security-model.md: "No secrets in any repository — ever."
# Copy to `.env` (git-ignored) for local runs of the reference runtime. This is
# NOT the production secret-management system — production secrets live in Google
# Secret Manager, provisioned per-environment by Terraform (docs/security.md).
#
# Nothing here is used by production. Production configuration comes from the
# environment/secrets, never from a committed file (aion-infra §14, §41).

# ── Reference runtime (runtime/) — local only ────────────────────────────────
AION_ENVIRONMENT=local
PORT=8080
LOG_LEVEL=info
DATABASE_SSL=false
RUN_SMOKE_ON_BOOT=true

# App-role connection (DML only). For the aion-data docker-compose DB:
DATABASE_URL=postgresql://aion_app:CHANGE_ME_LOCAL_ONLY@localhost:5432/aion_data

# Migration-role connection (DDL) — used ONLY by the migrate entrypoint/job,
# never by the long-running runtime.
MIGRATION_DATABASE_URL=postgresql://aion_migrator:CHANGE_ME_LOCAL_ONLY@localhost:5432/aion_data

# Release metadata (injected by the pipeline in real deploys).
SERVICE_VERSION=0.1.0
GIT_SHA=local
BUILD_TIME=1970-01-01T00:00:00Z

# ── Terraform (do NOT put passwords here; use TF_VAR_* env at apply time) ─────
# export TF_VAR_project_id=aion-staging-xxxx
# export TF_VAR_app_password=...        # from generated/rotated secret material
# export TF_VAR_migrator_password=...
